# Database
# Internal (default): leave LABPULSE_DATABASE_URL blank/unset to use the bundled
# SQLite database on the labpulse-data volume.
LABPULSE_DATABASE_URL=

# Custom/external: set a full SQLAlchemy URL instead (takes precedence over the
# internal SQLite database when non-empty), e.g.:
# LABPULSE_DATABASE_URL=postgresql+psycopg2://pgadmin:changeme@10.5.0.33:5432/labpulse

# Retention
LABPULSE_EVENT_RETENTION_DAYS=30
LABPULSE_METRIC_RETENTION_DAYS=7

# Collection
LABPULSE_POLL_INTERVAL=15

# Login credentials for the single shared admin account - change these, especially
# LABPULSE_SECRET_KEY (used to sign session tokens; changing it invalidates sessions).
LABPULSE_ADMIN_USERNAME=admin
LABPULSE_ADMIN_PASSWORD=admin
LABPULSE_SECRET_KEY=change-me
